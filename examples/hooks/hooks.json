{
  "description": "OPTIONAL metadata-only native lifecycle handlers for explicitly bound active workbenches. Not registered or enabled by the plugin manifest. Review and approval required before deployment.",
  "hooks": {
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/src/native-hook.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/src/native-hook.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreModelRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/src/native-hook.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
