{
  "description": "Metadata-only native lifecycle handlers declared by the plugin for explicitly bound active workbenches. Review and trust through the native host before execution.",
  "hooks": {
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/src/native-hook.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/src/native-hook.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreModelRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/src/native-hook.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
